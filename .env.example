# =============================================================================
# Master Touch CMS — Environment Variables
# Copy to `.env.local` for local development, or set in cPanel Node.js App.
# Build succeeds without these; runtime requires Supabase + Upstash.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# Local example:
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=ar
NODE_ENV=development

# Production (cPanel) — set these instead of localhost:
# NEXT_PUBLIC_APP_URL=https://www.mastertouchksa.com
# NODE_ENV=production
# HOSTNAME=0.0.0.0
# PORT is assigned automatically by Passenger — do not hardcode

# -----------------------------------------------------------------------------
# Supabase (required at runtime)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Auth redirects (must match Supabase Auth URL config)
# Local:
NEXT_PUBLIC_AUTH_REDIRECT_URL=http://localhost:3000/ar/reset-password
# Production:
# NEXT_PUBLIC_AUTH_REDIRECT_URL=https://www.mastertouchksa.com/ar/reset-password

# -----------------------------------------------------------------------------
# Upstash Redis (required at runtime for rate limiting)
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://YOUR_UPSTASH.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# -----------------------------------------------------------------------------
# Monitoring (optional)
# -----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# -----------------------------------------------------------------------------
# Optional integrations
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
