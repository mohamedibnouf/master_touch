# =============================================================================
# Master Touch CMS — Environment Variables
# Copy to `.env.local` for local development, or set in cPanel Node.js App.
# Build succeeds without these; runtime requires Supabase (+ Upstash for rate limits).
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# Local:
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Production (cPanel):
# NEXT_PUBLIC_APP_URL=https://www.mastertouchksa.com
# NODE_ENV=production
# HOSTNAME=0.0.0.0
# PORT is assigned automatically by Passenger — do not hardcode

# -----------------------------------------------------------------------------
# Supabase (required at runtime)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Configure Auth redirect URLs in the Supabase dashboard to:
#   {NEXT_PUBLIC_APP_URL}/ar/reset-password
#   {NEXT_PUBLIC_APP_URL}/en/reset-password

# -----------------------------------------------------------------------------
# Upstash Redis (required for login/contact rate limiting)
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://YOUR_UPSTASH.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# -----------------------------------------------------------------------------
# Monitoring (optional)
# -----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
OTEL_EXPORTER_OTLP_ENDPOINT=
