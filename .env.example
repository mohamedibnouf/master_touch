# =============================================================================
# Master Touch CMS — Environment Variables (Phase 1.5 — Production)
# Copy to .env.local. Demo mode has been removed; these are required at runtime.
# =============================================================================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=ar
NODE_ENV=development

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Auth redirects (must match Supabase Auth URL config)
NEXT_PUBLIC_AUTH_REDIRECT_URL=http://localhost:3000/ar/reset-password

# Upstash Redis (required for rate limiting)
UPSTASH_REDIS_REST_URL=https://YOUR_UPSTASH.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# Monitoring (optional — hooks ready)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional integrations
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
