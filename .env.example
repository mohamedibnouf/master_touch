# =============================================================================
# Master Touch CMS — Environment Variables
# Copy to `.env.local` for local development, or set in cPanel Node.js App.
# Build succeeds without these; runtime requires Supabase (+ Upstash for rate limits).
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# Local:
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Production (cPanel):
# NEXT_PUBLIC_APP_URL=https://mastertouch-ksa.com
# NODE_ENV=production
# HOSTNAME=0.0.0.0
# PORT is assigned automatically by Passenger — do not hardcode

# -----------------------------------------------------------------------------
# Supabase (required at runtime)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Auth URL configuration (Supabase Dashboard → Authentication → URL Configuration):
#   Site URL:
#     https://mastertouch-ksa.com
#   Redirect URLs (allowlist):
#     https://mastertouch-ksa.com/auth/confirm
#     https://mastertouch-ksa.com/ar/reset-password
#     https://mastertouch-ksa.com/en/reset-password
#     https://mastertouch-ksa.com/ar/login
#     https://mastertouch-ksa.com/en/login
#
# Invite email template (Dashboard → Authentication → Email Templates → Invite):
#   Do NOT use {{ .ConfirmationURL }} (that always points at *.supabase.co).
#   Use a custom-domain link with TokenHash instead, for example:
#     <a href="{{ .SiteURL }}/auth/confirm?token_hash={{ .TokenHash }}&type=invite">Accept invitation</a>
#   Optional next path (must be relative under /ar or /en):
#     ...&next=/ar/reset-password
#
# Recovery / magic-link templates can use the same /auth/confirm pattern with type=recovery or type=email.

# -----------------------------------------------------------------------------
# Upstash Redis (required for login/contact rate limiting)
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://YOUR_UPSTASH.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# -----------------------------------------------------------------------------
# Monitoring (optional)
# -----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
OTEL_EXPORTER_OTLP_ENDPOINT=
